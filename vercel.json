{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        { "source": "/api/__sync", "destination": "/api/sync" },
        { "source": "/api/__analysis", "destination": "/api/analysis" },
        { "source": "/api/__warnings", "destination": "/api/warnings" },
        { "source": "/api/__journal", "destination": "/api/journal" }
    ]
}
