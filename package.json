{
    "name": "gradient-lab",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Песочница подбора CSS-градиентов, градиентных масок и blur-затуханий с live-сравнением по макету и агентским HTTP API",
    "author": "hwnd1982",
    "license": "MIT",
    "keywords": [
        "gradient",
        "css",
        "mask",
        "blur",
        "backdrop-filter",
        "sandbox",
        "figma",
        "design-tool",
        "vercel",
        "ai-agent"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hwnd1982/gradient-lab.git"
    },
    "bugs": {
        "url": "https://github.com/hwnd1982/gradient-lab/issues"
    },
    "homepage": "https://github.com/hwnd1982/gradient-lab#readme",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build && node scripts/build-functions.mjs",
        "lint": "oxlint",
        "test": "node tests/run.mjs",
        "preview": "vite preview",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
    },
    "dependencies": {
        "react": "^19.2.8",
        "react-colorful": "^5.8.1",
        "react-dom": "^19.2.8",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "oxlint": "^1.81.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "vite": "^8.3.0",
        "rolldown": "1.2.13"
    }
}
